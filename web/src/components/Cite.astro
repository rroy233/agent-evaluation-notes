---
// 正文里的引用编号。第一次出现在正文时带 id，供参考文献条目回跳。
import { ui } from '../lib/ui';

interface Props {
  n: number;
  anchor?: boolean;
}
const { n, anchor = false } = Astro.props;
const t = ui(Astro.locals.starlightRoute?.lang);
---

<a class="cite" href={`#ref-${n}`} id={anchor ? `cite-${n}` : undefined} title={t.citeJump(n)}>[{n}]</a>
