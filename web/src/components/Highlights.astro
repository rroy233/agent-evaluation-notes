---
// 划重点的界面。整页只渲染一次，脚本按章页判断是否启用。
// 用原生 <dialog>，键盘与读屏软件可以直接用；没有 JavaScript 时这些元素不出现，
// 正文和链接不受影响。
import { ui } from '../lib/ui';

const t = ui(Astro.locals.starlightRoute?.lang);
---

<button id="open-highlights" class="highlights-toggle" type="button" hidden>
  <span>{t.highlightsTitle}</span><span id="highlight-count">0</span>
</button>

<div id="highlight-selection" class="highlight-selection" role="group" aria-label={t.selectedText} hidden>
  <button id="save-highlight" type="button">{t.highlight}</button>
</div>

<p id="highlight-status" class="highlight-status" role="status"></p>

<dialog id="highlights-dialog" class="hl-dialog" aria-labelledby="highlights-title">
  <div class="hl-dialog-head">
    <h2 id="highlights-title">{t.highlightsTitle}</h2>
    <button id="close-highlights" class="hl-icon-button" type="button" aria-label={t.closeHighlights}>×</button>
  </div>
  <p class="hl-dialog-help">{t.highlightsHelp}</p>
  <div class="hl-backup-row">
    <button id="export-highlights" type="button">{t.exportBackup}</button>
    <label class="hl-import">{t.importBackup}<input id="import-highlights" type="file" accept="application/json,.json" /></label>
  </div>
  <div id="highlight-backup-panel" hidden>
    <label for="highlight-backup-json">{t.backupContent}</label>
    <textarea id="highlight-backup-json" rows="4" readonly></textarea>
    <button id="copy-highlight-backup" type="button">{t.copyBackup}</button>
    <p class="hl-dialog-help">{t.backupHelp}</p>
  </div>
  <p id="highlight-dialog-status" role="status"></p>
  <div id="highlight-undo" class="hl-undo" hidden>
    <div>
      <p id="highlight-undo-message" role="status"></p>
      <p class="hl-dialog-help">{t.undoHelp}</p>
    </div>
    <button id="undo-highlight" type="button">{t.undo}</button>
  </div>
  <p id="highlights-empty">{t.highlightsEmpty}</p>
  <ol id="highlights-list"></ol>
</dialog>

<script>
  import { initHighlights } from '../scripts/highlights';

  const start = () => {
    void initHighlights().catch((err) => console.warn('划重点初始化失败', err));
  };
  document.addEventListener('astro:page-load', start);
</script>
