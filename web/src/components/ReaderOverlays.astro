---
// 图片查看器。整页只渲染一次。
import { ui } from '../lib/ui';

const t = ui(Astro.locals.starlightRoute?.lang);
---

<dialog id="figure-dialog" class="figure-dialog" aria-label={t.viewerAria}>
  <div class="figure-dialog-bar">
    <button id="figure-zoom-out" type="button" title={t.zoomOut}>{t.zoomOut}</button>
    <output id="figure-zoom-level" aria-live="polite">100%</output>
    <button id="figure-zoom-in" type="button" title={t.zoomIn}>{t.zoomIn}</button>
    <button id="figure-fit" type="button">{t.fitWidth}</button>
    <a id="figure-original" href="#" target="_blank" rel="noopener">{t.openOriginal}</a>
    <button id="close-figure" type="button">{t.close}</button>
  </div>
  <div id="figure-canvas" class="figure-canvas" tabindex="0">
    <img id="expanded-figure" alt="" draggable="false" />
  </div>
  <p id="figure-caption" class="figure-dialog-caption"></p>
</dialog>

<script>
  import { initFigureViewer } from '../scripts/figure-viewer';

  const start = () => initFigureViewer();
  document.addEventListener('astro:page-load', start);
</script>
