{
  "_comment": "字体源文件与 woff2 产物的对应关系。dev/fetch-fonts.mjs 按 sources 下载，dev/build-fonts.py 按 outputs 整份转 woff2。",
  "sources": [
    {
      "file": "SourceHanSerifCN-Regular.otf",
      "url": "https://github.com/adobe-fonts/source-han-serif/raw/release/SubsetOTF/CN/SourceHanSerifCN-Regular.otf",
      "bytes": 11626108,
      "license": "LICENSE-SourceHanSerif.txt",
      "licenseUrl": "https://raw.githubusercontent.com/adobe-fonts/source-han-serif/release/LICENSE.txt"
    },
    {
      "file": "SourceHanSerifCN-Bold.otf",
      "url": "https://github.com/adobe-fonts/source-han-serif/raw/release/SubsetOTF/CN/SourceHanSerifCN-Bold.otf",
      "bytes": 12094680,
      "license": "LICENSE-SourceHanSerif.txt",
      "licenseUrl": "https://raw.githubusercontent.com/adobe-fonts/source-han-serif/release/LICENSE.txt"
    },
    {
      "file": "Newsreader-VF.ttf",
      "url": "https://github.com/google/fonts/raw/main/ofl/newsreader/Newsreader%5Bopsz,wght%5D.ttf",
      "bytes": null,
      "license": "LICENSE-Newsreader.txt",
      "licenseUrl": "https://raw.githubusercontent.com/google/fonts/main/ofl/newsreader/OFL.txt"
    },
    {
      "file": "Newsreader-Italic-VF.ttf",
      "url": "https://github.com/google/fonts/raw/main/ofl/newsreader/Newsreader-Italic%5Bopsz,wght%5D.ttf",
      "bytes": null,
      "license": "LICENSE-Newsreader.txt",
      "licenseUrl": "https://raw.githubusercontent.com/google/fonts/main/ofl/newsreader/OFL.txt"
    }
  ],
  "outputs": [
    {
      "font": "SourceHanSerifCN-Regular.otf",
      "out": "SourceHanSerifSC-Regular.woff2",
      "practice": "中文正体"
    },
    {
      "font": "SourceHanSerifCN-Bold.otf",
      "out": "SourceHanSerifSC-Bold.woff2",
      "practice": "中文粗体"
    },
    {
      "font": "Newsreader-VF.ttf",
      "out": "Newsreader-Roman.woff2",
      "practice": "英文正体可变",
      "pinOpsz": 18
    },
    {
      "font": "Newsreader-Italic-VF.ttf",
      "out": "Newsreader-Italic.woff2",
      "practice": "英文斜体可变",
      "pinOpsz": 18
    }
  ]
}
